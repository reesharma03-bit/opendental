modules = ["java-graalvm22.3", "nodejs-20", "web", "bash"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8099
externalPort = 8099

[[ports]]
localPort = 23636
externalPort = 3001

[[ports]]
localPort = 24136
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Open Dental Java API"

[[workflows.workflow]]
name = "Open Dental Java API"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8099 RECONCILIATION_ENABLED=false mvn spring-boot:run"
waitForPort = 8099

[postMerge]
path = "SmileOS-AI-Dashboard/scripts/post-merge.sh"
timeoutMs = 180000

[userenv]

[userenv.shared]
OPENDENTAL_BASE_URL = "localhost 8080"
